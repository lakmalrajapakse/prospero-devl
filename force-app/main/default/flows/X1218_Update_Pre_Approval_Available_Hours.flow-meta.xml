<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Duration_to_Total</name>
        <label>Add Duration to Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_TotalShiftHours</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fx_ShiftDuration</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Shifts</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>fx_RemainingHours</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Pre_Approval__r.Hours__c} - {!var_TotalShiftHours}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_ShiftDuration</name>
        <dataType>Number</dataType>
        <expression>({!Loop_Shifts.sirenum__Scheduled_End_Time__c} - {!Loop_Shifts.sirenum__Scheduled_Start_Time__c}) * 24</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>1218 - Update Pre-Approval Available Hours {!$Flow.CurrentDateTime}</interviewLabel>
    <label>1218 - Update Pre-Approval Available Hours</label>
    <loops>
        <name>Loop_Shifts</name>
        <label>Loop Shifts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Related_Shifts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Duration_to_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Pre_Approval_Hours</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Related_Shifts</name>
        <label>Get All Related Shifts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Shifts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pre_Approval__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Pre_Approval__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>sirenum__Shift__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Pre_Approval_Hours</name>
        <label>Update Pre-Approval Hours</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Pre_Approval__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Available_hours__c</field>
            <value>
                <elementReference>fx_RemainingHours</elementReference>
            </value>
        </inputAssignments>
        <object>Pre_Approval__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Related_Shifts</targetReference>
        </connector>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         (
AND(
    ISCHANGED({!$Record.Pre_Approval__c}),
    NOT(ISBLANK({!$Record.Pre_Approval__r.Hours__c}))
)
         )
)</filterFormula>
        <object>sirenum__Shift__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_TotalShiftHours</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
