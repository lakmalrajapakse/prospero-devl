        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sensitive_Data_Record__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Site.Sensitive_Data_Record__c</elementReference>
            </value>
