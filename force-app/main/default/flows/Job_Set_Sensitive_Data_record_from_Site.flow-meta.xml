    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Site</targetReference>
        </connector>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         (ISBLANK({!$Record.Id}) || (NOT(ISBLANK({!$Record.Id})) &amp;&amp; ISCHANGED({!$Record.Child_Young_Person_Care_Package__c})))
