<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Conditions_Met</name>
        <label>Conditions Met</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(NOT 1)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.sirenum__Contract__r.sirenum__Client__r.Accepted_Worker_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.sirenum__Contact__r.Worker_Type_Payroll_Provider__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tick_More_than_7_days_Missmatch</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>121 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>1218: More than 7 days Missmatch when Worker Type does not match Client Worker Type</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Tick_More_than_7_days_Missmatch</name>
        <label>Tick More than 7 days Missmatch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>More_than_7_days_Missmatch__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Conditions_Met</targetReference>
        </connector>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         (
{!$Record.sirenum__Shift_Date__c} &gt;= {!$Record.sirenum__Placement__r.Mismatch_Date__c} + 7
         )
)</filterFormula>
        <object>sirenum__Shift__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
