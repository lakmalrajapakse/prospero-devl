        <assignmentItems>
            <assignToReference>varHSCShiftsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Collection_of_HSC_Shift_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Collection_of_HSC_Shift_records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_to_Variable</name>
        <label>Assign to Variable</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTEAShiftsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Collection_of_TEA_Shift_records</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Collection_of_TEA_Shift_records</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>TEA_or_HSC</name>
        <label>TEA or HSC?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Teaching</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Brand__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Teaching</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Collection_of_TEA_Shift_records</targetReference>
            </connector>
            <label>Teaching</label>
        </rules>
        <rules>
            <name>HSC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Brand__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Health &amp; Social Care</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Collection_of_HSC_Shift_records</targetReference>
            </connector>
            <label>HSC</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>1218 - Update Future TEA &amp; HSC Shifts when Job Details change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>1218 - Update Future TEA &amp; HSC Shifts when Job Details change</label>
    <loops>
        <name>Collection_of_HSC_Shift_records</name>
        <label>Collection of HSC Shift records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Future_Shifts_for_Job</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_new_HSC_Job_fields_to_Shift</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_HSC_Shifts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Collection_of_TEA_Shift_records</name>
        <label>Collection of TEA Shift records.</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Future_Shifts_for_Job</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_new_Job_fields_to_Shift</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_TEA_Shifts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Future_Shifts_for_Job</name>
        <label>Get Future Shifts for Job</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>TEA_or_HSC</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>s5m__BH4SFJob__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>sirenum__Shift_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>sirenum__Shift__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_HSC_Shifts</name>
        <label>Update HSC Shifts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varHSCShiftsToUpdate</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_TEA_Shifts</name>
        <label>Update TEA Shifts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varTEAShiftsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Future_Shifts_for_Job</targetReference>
        </connector>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         ((ISPICKVAL({!$Record.Brand__c}, &quot;Health &amp; Social Care&quot;) &amp;&amp; ISCHANGED({!$Record.Type_of_Care_Support__c})) || (ISPICKVAL({!$Record.Brand__c}, &quot;Teaching&quot;) &amp;&amp; (ISCHANGED({!$Record.Subject__c}) || ISCHANGED({!$Record.Programme__c}) || ISCHANGED({!$Record.Location_of_Delivery__c}) || ISCHANGED({!$Record.Delivery_Setting__c}) || ISCHANGED({!$Record.SEND_Support_Type__c}) || ISCHANGED({!$Record.Who_Is_The_Support_For__c}) || ISCHANGED({!$Record.Needs_of_the_Learners__c}))))
)</filterFormula>
        <object>TR1__Job__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varHSCShiftsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>sirenum__Shift__c</objectType>
    </variables>
    <variables>
        <name>varTEAShiftsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>sirenum__Shift__c</objectType>
    </variables>
</Flow>
