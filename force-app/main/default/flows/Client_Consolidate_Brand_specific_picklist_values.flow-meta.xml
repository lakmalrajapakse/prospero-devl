    <formulas>
        <name>AgeGroup</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!FinalAgeGroup}, 1) = &quot;;&quot;,
    LEFT({!FinalAgeGroup}, LEN({!FinalAgeGroup}) - 1),
    {!FinalAgeGroup}
)</expression>
    </formulas>
    <formulas>
        <name>Department</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!FinalDepartment}, 1) = &quot;;&quot;,
