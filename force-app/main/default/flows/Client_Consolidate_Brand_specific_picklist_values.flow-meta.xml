    {!FinalDepartment}
)</expression>
    </formulas>
    <formulas>
        <name>FinalAgeGroup</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!VarTAG}),
    {!VarHSAG},
    IF(
        ISBLANK({!VarHSAG}),
        {!VarTAG},
        IF(
            {!VarTAG} = {!VarHSAG},
            {!VarTAG},
            {!VarTAG} &amp; &quot;;&quot; &amp; {!VarHSAG}
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>FinalDepartment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!VarTD}),
    {!VarHSD},
    IF(
        ISBLANK({!VarHSD}),
        {!VarTD},
        IF(
            {!VarTD} = {!VarHSD},
            {!VarTD},
            {!VarTD} &amp; &quot;;&quot; &amp; {!VarHSD}
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>FinalType</name>
        <dataType>String</dataType>
        <expression>IF(
    {!VarTT} = {!VarHST},
    IF(
        {!VarTT} = {!VarIT},
        {!VarTT},
        {!VarTT} &amp;
        IF(ISBLANK({!VarIT}), &quot;&quot;, &quot;;&quot; &amp; {!VarIT})
    ),
    IF(
        {!VarTT} = {!VarIT},
        {!VarTT} &amp;
        IF(ISBLANK({!VarHST}), &quot;&quot;, &quot;;&quot; &amp; {!VarHST}),
        IF(
            {!VarHST} = {!VarIT},
            IF(
                ISBLANK({!VarTT}),
                {!VarHST},
                {!VarTT} &amp;
                IF(ISBLANK({!VarHST}), &quot;&quot;, &quot;;&quot; &amp; {!VarHST})
            ),
            IF(
                ISBLANK({!VarTT}),
                &quot;&quot;,
                {!VarTT} &amp;
                IF(
                    OR(ISBLANK({!VarHST}), {!VarHST} = {!VarTT}),
                    &quot;&quot;,
                    &quot;;&quot; &amp; {!VarHST}
                ) &amp;
                IF(
                    OR(
                        ISBLANK({!VarIT}),
                        {!VarIT} = {!VarTT},
                        {!VarIT} = {!VarHST}
                    ),
                    &quot;&quot;,
                    &quot;;&quot; &amp; {!VarIT}
                )
            ) &amp;
            IF(
                AND(
                    ISBLANK({!VarTT}),
                    NOT(ISBLANK({!VarHST}))
                ),
                {!VarHST},
                &quot;&quot;
            )
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>Type</name>
        <dataType>String</dataType>
        <expression>IF(
    RIGHT({!FinalType}, 1) = &quot;;&quot;,
    LEFT({!FinalType}, LEN({!FinalType}) - 1),
    {!FinalType}
)</expression>
    </formulas>
