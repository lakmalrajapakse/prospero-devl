    <environments>Default</environments>
    <formulas>
        <name>formula_RemoveTeam</name>
        <dataType>String</dataType>
        <expression>TRIM(
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
                {!$Record.User__r.Team__c},
                {!$Record.Team__r.Name} &amp; &quot;, &quot;,
                &quot;&quot;
            ),
            &quot;, &quot; &amp; {!$Record.Team__r.Name},
            &quot;&quot;
        ),
        {!$Record.Team__r.Name},
        &quot;&quot;
    )
)</expression>
    </formulas>
    <interviewLabel>Remove User from Public Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Remove User from Public Group</label>
    <processMetadataValues>
        <name>BuilderType</name>
