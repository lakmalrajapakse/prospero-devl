            <field>Mismatch_Date__c</field>
            <value>
                <elementReference>Get_Placement.sirenum__Start_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.sirenum__Placement__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         NOT(ISBLANK({!$Record.sirenum__Contact__c}))
)</filterFormula>
