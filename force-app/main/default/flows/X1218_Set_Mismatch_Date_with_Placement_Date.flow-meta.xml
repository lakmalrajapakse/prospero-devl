    <decisions>
        <name>Conditions_Met</name>
        <label>Conditions Met</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1 AND (NOT 2)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.sirenum__Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.sirenum__Contract__r.sirenum__Client__r.Accepted_Worker_Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.sirenum__Contact__r.Worker_Type_Payroll_Provider__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Placement</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>1218: Set Mismatch Date with Placement Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>1218: Set Mismatch Date with Placement Date</label>
