<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Council_Lookup</name>
        <label>Assign Council Lookup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Council_Lookup__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Parent.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Local_Authority_Lookup</name>
        <label>Assign Local Authority Lookup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Local_Authority__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Parent.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Parent_Type</name>
        <label>Parent Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other Type__c</defaultConnectorLabel>
        <rules>
            <name>Local_Authority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Local Authority</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Local_Authority_Lookup</targetReference>
            </connector>
            <label>Local Authority</label>
        </rules>
        <rules>
            <name>Council</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Council</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Council_Lookup</targetReference>
            </connector>
            <label>Council</label>
        </rules>
    </decisions>
    <description>This flow automatically populates the appropriate lookup field on a Child Client based on the Type of its Parent Client. If the Parent Client is a Local Authority, the Parent Client is populated in the Child Client&apos;s Local Authority Lookup field. If the Parent Client is a Council, the Parent Client is populated in the Child Client&apos;s Council Lookup field. The flow runs when a Client is created or updated and only makes the update where the relevant lookup does not already match the Parent Client.</description>
    <environments>Default</environments>
    <interviewLabel>Client Child assigned Local {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account:Local Authority or Council Lookup Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Parent_Type</targetReference>
        </connector>
        <filterFormula>AND(
    NOT({!$Permission.Bypass_System_Automation}),
    {!$Record.ParentId} &lt;&gt; NULL
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
