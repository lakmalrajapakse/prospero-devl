<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Placement</name>
        <label>Assign Placement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Sirenum_Placement.Salary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.TR1__Salary__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Sirenum_Placement.Fee_Percentage__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.TR1__Fee_Percentage__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Placement</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>Perm Closing Report - Update Sirenum Placement Salary and Fee {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Perm Closing Report - Update Sirenum Placement Salary and Fee</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sirenum_Placement</name>
        <label>Get Sirenum Placement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Placement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Sirenum_Placement__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>sirenum__Placement__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Placement</name>
        <label>Update Placement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Get_Sirenum_Placement</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sirenum_Placement</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISNEW()),
    {!$Record.RecordType.DeveloperName} = &quot;Permanent&quot;,
    OR(
        ISCHANGED({!$Record.TR1__Salary__c}),
        ISCHANGED({!$Record.TR1__Fee_Percentage__c})
    ),
    NOT(ISBLANK({!$Record.Sirenum_Placement__c}))
)</filterFormula>
        <object>TR1__Closing_Report__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
