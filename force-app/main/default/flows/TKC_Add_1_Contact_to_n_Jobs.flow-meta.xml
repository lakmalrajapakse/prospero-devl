    <description>This flow is triggered when TK portal is initiated from the Contact and &apos;Add Candidate to Job&apos; button was clicked</description>
    <environments>Default</environments>
    <formulas>
        <name>FurtherJobIds</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!JobIds})=18, &apos;&apos;,
IF(LEN({!JobIds})&gt;18,
TRIM(RIGHT({!JobIds}, LEN({!JobIds}) - FIND(&quot;,&quot;,{!JobIds}))),null))</expression>
    </formulas>
    <formulas>
        <name>GetNextJobId</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!JobIds}) =18, {!JobIds},
IF(LEN({!JobIds}) &gt;18,
LEFT({!JobIds}, FIND(&quot;,&quot;,{!JobIds}) - 1),null))</expression>
    </formulas>
    <formulas>
        <name>NoApplicationCreatedJobNamesComma</name>
        <dataType>String</dataType>
        <expression>{!LoopThoughApplications.TR1__Job__r.Name} &amp; &apos;, &apos;</expression>
    </formulas>
    <formulas>
        <name>NoApplicationCreatedJobNamesFinal</name>
        <dataType>String</dataType>
        <expression>LEFT( {!NoApplicationCreatedJobNames}, LEN({!NoApplicationCreatedJobNames})- 2)</expression>
    </formulas>
    <formulas>
        <name>NotificationBody</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Flow.FaultMessage}),

IF(ISBLANK({!NoApplicationCreatedJobNames}),
{!GetContact.Name} &amp; &apos; &apos; &amp; {!$Label.TKC_AddedTo} &amp; &apos; &apos; &amp; TEXT({!NumberOfApplicationsCreated}) &amp; &apos; &apos; &amp; {!$Label.TKC_Jobs} &amp; &apos;.&apos;,
{!GetContact.Name} &amp; &apos; &apos; &amp; {!$Label.TKC_AddedTo} &amp; &apos; &apos; &amp; TEXT({!NumberOfApplicationsCreated}) &amp; &apos; &apos; &amp; {!$Label.TKC_Jobs} &amp;  &apos;. &apos; &amp;
{!$Label.TKC_JobsNotAddedToCandidate} &amp; &apos; &apos; &amp; {!NoApplicationCreatedJobNames}
)

,{!$Label.TKC_ErrorMessage})</expression>
    </formulas>
    <formulas>
        <name>SelectedIdsLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!JobIds})</expression>
        <scale>2</scale>
    </formulas>
