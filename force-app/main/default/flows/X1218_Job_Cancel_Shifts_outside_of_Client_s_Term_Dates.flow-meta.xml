<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Shift_in_Break</name>
        <label>Is Shift in Break</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_AWR_Breaks</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Shift_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>1218: Job - Cancel Shifts outside of Client&apos;s Term Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>1218: Job - Cancel Shifts outside of Client&apos;s Term Dates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_AWR_Breaks</name>
        <label>Get AWR Breaks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Shift_in_Break</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>sirenum__Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.sirenum__Contract__r.sirenum__Client__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>sirenum__JobType__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.sirenum__Job_Type_Calculated__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>School_Break__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>sirenum__Start_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.sirenum__Shift_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>sirenum__End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.sirenum__Shift_Date__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>sirenum__AWR_Break__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Shift_Record</name>
        <label>Update Shift Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>sirenum__CancellationReason__c</field>
            <value>
                <stringValue>Term Breaks</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>sirenum__Cancelled__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         {!$Record.s5m__Auto_Generated__c}
)</filterFormula>
        <object>sirenum__Shift__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <scheduledPaths>
            <name>Check_Term_Break</name>
