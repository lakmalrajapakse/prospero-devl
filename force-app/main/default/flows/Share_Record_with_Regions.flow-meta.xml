    <description>Parses semicolon-separated Sharing_Regions__c string, splits into a collection, matches User Roles, and updates Account/Contact shares.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_NextRegion</name>
        <dataType>String</dataType>
        <expression>TRIM(IF(CONTAINS({!sharingRegionsWorking}, &quot;;&quot;), LEFT({!sharingRegionsWorking}, FIND(&quot;;&quot;, {!sharingRegionsWorking}) - 1), {!sharingRegionsWorking}))</expression>
    </formulas>
    <formulas>
        <name>fx_RemainingRegions</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!sharingRegionsWorking}, &quot;;&quot;), MID({!sharingRegionsWorking}, FIND(&quot;;&quot;, {!sharingRegionsWorking}) + 1, LEN({!sharingRegionsWorking})), &quot;&quot;)</expression>
    </formulas>
    <label>Share Record with Regions</label>
