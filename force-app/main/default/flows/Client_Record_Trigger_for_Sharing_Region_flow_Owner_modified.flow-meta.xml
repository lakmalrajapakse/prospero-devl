<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Client - Record Trigger for Sharing Region flow - Owner modified {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Client - Record Trigger for Sharing Region flow - Owner modified</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>AND(
         NOT({!$Permission.Bypass_System_Automation}),
         (

    ISCHANGED({!$Record.OwnerId})
         )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Delay_1_Minute</name>
            <connector>
                <targetReference>Share_Record_Modified</targetReference>
            </connector>
            <label>Delay 1 Minute</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Share_Record_Modified</name>
        <label>Share Record Modified</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Share_Record_with_Regions</flowName>
        <inputAssignments>
            <name>objectType</name>
            <value>
                <stringValue>Account</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>sharingRegions</name>
            <value>
                <elementReference>$Record.Sharing_Regions__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
