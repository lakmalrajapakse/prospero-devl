<![CDATA[<div><span style="background-color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">Hi {!Receiving_User.FirstName},</span></div><div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);"><br></span></font></div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);">Welcome to {!Community_Name}! To get started, go to </span><a href="{!Community_Url}">MyProspero</a></font></div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);"><br></span></font></div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);">Username: {!Receiving_User.Username}</span></font></div></div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);"><br></span></font></div><div style="font-size: 12pt;"><font face="Arial, Helvetica, sans-serif"><span style="background-color: rgb(255, 255, 255);">Thanks,</span></font></div><div style="font-size: 12pt;">Prospero</div>]]></td>
</tr>
